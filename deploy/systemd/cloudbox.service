[Unit]
Description=CloudBox Gunicorn Service
After=network.target

[Service]
Type=simple
User=cloudbox
Group=cloudbox
WorkingDirectory=/opt/cloudbox
EnvironmentFile=/etc/cloudbox/cloudbox.env
ExecStart=/opt/cloudbox/.venv/bin/gunicorn --workers 2 --threads 4 --timeout 120 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - "app:create_app()"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

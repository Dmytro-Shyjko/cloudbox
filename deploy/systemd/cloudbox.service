[Unit]
Description=CloudBox Flask Application
After=network.target

[Service]
Type=simple
User=cloudbox
Group=cloudbox
WorkingDirectory=/opt/cloudbox
EnvironmentFile=/etc/cloudbox/cloudbox.env
ExecStart=/opt/cloudbox/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:8000 run:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

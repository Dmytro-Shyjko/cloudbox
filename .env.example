# CloudBox runtime configuration
# Generate a strong random value with at least 32 characters.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long

# Upload request size limit for Flask (MB).
UPLOAD_MAX_MB=1024

# Chunked upload foundation settings (routes are not enabled yet).
# Relative paths are resolved against Flask instance_path.
UPLOAD_TMP_DIR=instance/uploads_tmp
CHUNK_SIZE_DEFAULT_MB=5
CHUNK_SIZE_MAX_MB=10
UPLOAD_TTL_HOURS=24
MAX_ACTIVE_UPLOADS_PER_USER=3
